# ==========================================
# CẤU HÌNH MẪU SOSA BOT (Copy file này thành .env)
# ==========================================

# Token xác thực Bot Discord (Lấy tại https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Tiền tố lệnh (Prefix)
COMMAND_PREFIX=!

# Mã bảo mật thực thi lệnh cấp cao /setup-server
SETUP_MASTER_KEY=your_secure_master_key

# Cấu hình AutoMod
# Danh sách từ cấm, phân cách bằng dấu phẩy
BAD_WORDS=từ_cấm_1,từ_cấm_2,toxic

# Giới hạn spam tin nhắn (SPAM_LIMIT tin trong SPAM_TIME giây)
SPAM_LIMIT=5
SPAM_TIME=3

# Mức độ log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
