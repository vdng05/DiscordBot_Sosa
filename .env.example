# ==========================================
# CẤU HÌNH MẪU SOSA BOT (Copy file này thành .env)
# ==========================================

# Token xác thực Bot Discord (Lấy tại https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# ID của bạn (User ID trên Discord để dùng các lệnh Admin như !sync, !reload)
OWNER_IDS=your_discord_user_id

# Tiền tố lệnh Prefix
COMMAND_PREFIX=!

# Tự động sync Slash Commands khi khởi động (Mặc định: false - Chống Rate Limit Discord)
SYNC_ON_STARTUP=false

# Mã bảo mật thực thi lệnh cấp cao /setup-server (Nhập qua hộp thoại Modal bí mật)
SETUP_MASTER_KEY=your_secure_master_key

# Giới hạn ký tự tối đa cho mỗi lệnh đọc /speak (chống DoS / spam voice)
TTS_MAX_LENGTH=300

# Cấu hình AutoMod
# Danh sách từ cấm, phân cách bằng dấu phẩy
BAD_WORDS=từ_cấm_1,từ_cấm_2,toxic

# Giới hạn spam tin nhắn (SPAM_LIMIT tin trong SPAM_TIME giây)
SPAM_LIMIT=5
SPAM_TIME=3

# Mức độ log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
